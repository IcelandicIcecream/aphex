node_modules

# Output
.output
.turbo
.vercel
.netlify
/uploads
apps/studio/static/uploads
# Local media, now stored outside static/ so it is reachable only via /media
apps/studio/uploads
templates/*/uploads
.wrangler
.svelte-kit
/.svelte-kit
.next
packages/*/dist
dist

# TypeScript compilation artifacts in source folders
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
!packages/*/src/**/*.svelte.d.ts
!app.d.ts
# Hand-written ambient declarations are source, not artifacts — the rules above are
# aimed at tsc output landing next to sources.
!packages/*/src/ambient.d.ts
*.tsbuildinfo

# Keep the CLI generated just for the sake of CLI functionality in dev mode
!packages/cms-core/src/cli/*.js

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# storage
apps/studio/storage/assets/
# written by the upload tests — tests/fixtures/config.ts points storage at local
# disk so they never touch the real S3/R2 bucket
apps/studio/storage/test-assets/

# templates
templates/*/storage/assets/
templates/*/build/
templates/*/node_modules/
templates/*/.svelte-kit/
templates/*/.turbo/
templates/*/.env
templates/*/.env.*
!templates/*/.env.example

# IDE
.vscode/
*.code-workspace
DS_Store

# References
/references
apps/studio/build

# Local dev uploads in templates. The seeds no longer read from here —
# bundled fixtures live in src/lib/server/seed/assets/, outside the served tree.
templates/*/static/uploads

# Studio landing page — local-only marketing page, deliberately not shipped with
# the reference app. Ignored because `git add .` kept sweeping it into release
# commits; add it with `git add -f` if it ever should ship.
apps/studio/src/routes/landing-page/
apps/studio/static/icons/
apps/studio/static/images/aphex-diner-rigatoni.jpg
.aphex-standalone/

# Codex config carries plaintext MCP API keys in `http_headers`, one per server
# and including production. Ignored by file rather than by directory so that
# skills or anything else shareable added under `.codex/` can still be tracked.
.codex/config.toml
.pnpm-store/
