{
	"name": "@aphexcms/auth",
	"version": "0.2.2",
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/IcelandicIcecream/aphex.git",
		"directory": "packages/auth"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js",
			"default": "./dist/client.js"
		},
		"./schema/pg": {
			"types": "./dist/schema/pg.d.ts",
			"import": "./dist/schema/pg.js",
			"default": "./dist/schema/pg.js"
		},
		"./schema/sqlite": {
			"types": "./dist/schema/sqlite.d.ts",
			"import": "./dist/schema/sqlite.js",
			"default": "./dist/schema/sqlite.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"prepublishOnly": "pnpm build",
		"clean": "rm -rf dist"
	},
	"peerDependencies": {
		"@aphexcms/cms-core": "workspace:>=11.2.0"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.6.25",
		"better-auth": "^1.6.25",
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"@aphexcms/cms-core": "workspace:^",
		"typescript": "^5.9.3"
	}
}
