# This file has to stand on its own. The template is split out of the AphexCMS
# monorepo into a standalone repo (IcelandicIcecream/aphex-base) and scaffolded
# from there, so the monorepo's root .gitignore does NOT come with it — anything
# missing here gets committed to the public template repo and to every project
# scaffolded from it. The sync workflow runs `pnpm install && pnpm build` in this
# folder before mirroring it, so an unignored node_modules/.svelte-kit ships.

node_modules

# Build output
/.svelte-kit
/build
.output
.vercel
.netlify
.wrangler

# Secrets — .env holds real credentials once a project is scaffolded.
.env
.env.*
!.env.example
!.env.test

# pglite embedded database (APHEX_DATABASE=pglite)
.aphex/

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Runtime uploads. The two bundled originals are source fixtures for first-run seeding.
/static/uploads/*
!/static/uploads/fe043f55-aee4-4bb3-a8e5-afa16e08b8b5/
/static/uploads/fe043f55-aee4-4bb3-a8e5-afa16e08b8b5/*
!/static/uploads/fe043f55-aee4-4bb3-a8e5-afa16e08b8b5/original.jpg
!/static/uploads/aa1d4dfc-b639-448d-898a-247f56c222cd/
/static/uploads/aa1d4dfc-b639-448d-898a-247f56c222cd/*
!/static/uploads/aa1d4dfc-b639-448d-898a-247f56c222cd/original.png

# OS
.DS_Store
Thumbs.db
